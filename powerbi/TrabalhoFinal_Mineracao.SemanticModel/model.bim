            "sourceColumn": "Fonte",
            "summarizeBy": "none",
            "sortByColumn": "Ordem"
          },
          {
            "name": "Estudantes",
            "dataType": "int64",
            "sourceColumn": "Estudantes",
            "summarizeBy": "sum"
          },
          {
            "name": "Ordem",
            "dataType": "int64",
            "sourceColumn": "Ordem",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Qtd Estudantes Fonte",
            "expression": "SUM(resumo_cobertura_fontes[Estudantes])",
            "formatString": "0"
          }
        ],
        "partitions": [
          {
            "name": "resumo_cobertura_fontes",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Parquet.Document(File.Contents(\"c:\\\\Projects\\\\trabalho-final-mineacao-de-dados\\\\data\\\\gold\\\\dim_aluno.parquet\")),",
                "    Cols = Table.SelectColumns(Fonte, {\"tem_matricula\", \"tem_nota\", \"tem_acesso\", \"tem_redes\", \"tem_financeiro\", \"tem_deslocamento\", \"tem_frequencia\"}),",
                "    Agr = Table.Group(Cols, {}, {",
                "        {\"Matrículas\", (t) => Table.RowCount(Table.SelectRows(t, (r) => r[tem_matricula] = true)), Int64.Type},",
