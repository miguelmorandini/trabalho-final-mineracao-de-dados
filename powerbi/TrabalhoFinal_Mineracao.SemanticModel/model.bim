        "partitions": [
          {
            "name": "fato_aluno_360",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Csv.Document(File.Contents(\"c:\\\\Projects\\\\trabalho-final-mineacao-de-dados\\\\data\\\\gold\\\\fato_aluno_360.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    #\"Cabeçalhos Promovidos\" = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    #\"Tipo Alterado\" = Table.TransformColumnTypes(#\"Cabeçalhos Promovidos\", {{\"id_aluno\", Int64.Type}, {\"total_matriculas\", Int64.Type}, {\"qtd_ativo\", Int64.Type}, {\"qtd_evadido\", Int64.Type}, {\"qtd_trancado\", Int64.Type}, {\"faculdade_principal\", type text}, {\"curso_principal\", type text}, {\"semestre_principal\", Int64.Type}, {\"evadido_target\", Int64.Type}, {\"sexo\", type text}, {\"idade\", Int64.Type}, {\"faixa_etaria\", type text}, {\"cidade\", type text}, {\"renda_estimada\", type number}, {\"faixa_renda\", type text}, {\"nota_media\", type number}, {\"nota_mediana\", type number}, {\"qtd_notas_validas\", type number}, {\"qtd_notas_invalidas\", type number}, {\"total_acessos\", type number}, {\"tempo_logado_total\", type number}, {\"tempo_logado_medio\", type number}, {\"paginas_total\", Int64.Type}, {\"interacoes_total\", Int64.Type}, {\"seguidores_medio\", type number}, {\"seguindo_medio\", type number}, {\"qtd_lancamentos_fin\", Int64.Type}, {\"valor_mensalidade_total\", type number}, {\"valor_pago_total\", type number}, {\"qtd_inadimplente\", type number}, {\"taxa_inadimplencia\", type number}, {\"prob_evasao\", type number}, {\"faixa_risco_evasao\", type text}, {\"cluster_id\", Int64.Type}})",
                "in",
                "    #\"Tipo Alterado\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Alunos",
            "expression": "COUNTROWS(fato_aluno_360)",
            "formatString": "#,0"
          },
          {
            "name": "Alunos Evadidos",
            "expression": "SUM(fato_aluno_360[evadido_target])",
            "formatString": "#,0"
          },
          {
            "name": "Taxa Evasao (%)",
            "expression": "DIVIDE([Alunos Evadidos], [Total Alunos], 0)",
            "formatString": "0.00%"
          },
          {
            "name": "Alunos Alto Risco",
            "expression": "CALCULATE(COUNTROWS(fato_aluno_360), fato_aluno_360[faixa_risco_evasao] = \"Alto Risco\")",
            "formatString": "#,0"
          },
          {
            "name": "% Alunos Alto Risco",
            "expression": "DIVIDE([Alunos Alto Risco], [Total Alunos], 0)",
            "formatString": "0.00%"
          },
          {
            "name": "Nota Media Geral",
            "expression": "AVERAGE(fato_aluno_360[nota_media])",
            "formatString": "0.00"
          },
          {
            "name": "Renda Media",
            "expression": "AVERAGE(fato_aluno_360[renda_estimada])",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Tempo Logado Medio",
            "expression": "AVERAGE(fato_aluno_360[tempo_logado_medio])",
            "formatString": "0.0"
          },
          {
            "name": "Prob Media Evasao",
            "expression": "AVERAGE(fato_aluno_360[prob_evasao])",
            "formatString": "0.0%"
          },
          {
            "name": "Taxa Evasao Multi-Matricula (%)",
            "expression": "CALCULATE([Taxa Evasao (%)], fato_aluno_360[total_matriculas] > 1)",
            "formatString": "0.00%"
          },
          {
            "name": "Gap vs Benchmark INEP (pp)",
            "expression": "([Taxa Evasao (%)] * 100) - 28.0",
            "formatString": "+0.00;-0.00;0.00"
          }
        ]
      },
