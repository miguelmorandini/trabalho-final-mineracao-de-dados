            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Parquet.Document(File.Contents(\"c:\\\\Projects\\\\trabalho-final-mineacao-de-dados\\\\data\\\\gold\\\\dim_aluno.parquet\")),",
                "    #\"Colunas Selecionadas\" = Table.SelectColumns(Fonte, {\"id_aluno\", \"sexo\", \"ordem_sexo\", \"idade\", \"faixa_etaria_detalhada\", \"ordem_faixa_etaria\", \"cidade\", \"top12_cidade\", \"renda_estimada\", \"faixa_renda_detalhada\", \"ordem_faixa_renda\", \"flag_sexo_ausente\", \"flag_cidade_ausente\", \"flag_idade_ausente\", \"flag_renda_ausente\", \"tem_matricula\", \"tem_nota\", \"tem_acesso\", \"tem_redes\", \"tem_financeiro\", \"tem_deslocamento\", \"tem_frequencia\", \"tem_complementar\", \"qtd_fontes\", \"faixa_matriculas\", \"ordem_matriculas\", \"faixa_avaliacoes\", \"ordem_avaliacoes\", \"faixa_acessos\", \"ordem_acessos\", \"nota_media_clip\", \"faixa_nota\", \"ordem_nota\", \"cobertura_digital\", \"ordem_cobertura_digital\"}),",
                "    #\"Tipo Alterado\" = Table.TransformColumnTypes(#\"Colunas Selecionadas\", {{\"id_aluno\", Int64.Type}, {\"sexo\", type text}, {\"ordem_sexo\", Int64.Type}, {\"idade\", Int64.Type}, {\"faixa_etaria_detalhada\", type text}, {\"ordem_faixa_etaria\", Int64.Type}, {\"cidade\", type text}, {\"top12_cidade\", type logical}, {\"renda_estimada\", type number}, {\"faixa_renda_detalhada\", type text}, {\"ordem_faixa_renda\", Int64.Type}, {\"flag_sexo_ausente\", type logical}, {\"flag_cidade_ausente\", type logical}, {\"flag_idade_ausente\", type logical}, {\"flag_renda_ausente\", type logical}, {\"tem_matricula\", type logical}, {\"tem_nota\", type logical}, {\"tem_acesso\", type logical}, {\"tem_redes\", type logical}, {\"tem_financeiro\", type logical}, {\"tem_deslocamento\", type logical}, {\"tem_frequencia\", type logical}, {\"tem_complementar\", type logical}, {\"qtd_fontes\", Int64.Type}, {\"faixa_matriculas\", type text}, {\"ordem_matriculas\", Int64.Type}, {\"faixa_avaliacoes\", type text}, {\"ordem_avaliacoes\", Int64.Type}, {\"faixa_acessos\", type text}, {\"ordem_acessos\", Int64.Type}, {\"nota_media_clip\", type number}, {\"faixa_nota\", type text}, {\"ordem_nota\", Int64.Type}, {\"cobertura_digital\", type text}, {\"ordem_cobertura_digital\", Int64.Type}})",
                "in",
                "    #\"Tipo Alterado\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Qtd Estudantes",
            "expression": "COUNTROWS(dim_aluno)",
            "formatString": "0"
          },
          {
            "name": "Qtd Estudantes Acessos",
            "expression": "COUNTROWS(dim_aluno) + 0",
            "formatString": "0"
          },
          {
            "name": "Total de Estudantes",
            "expression": "VAR v = COUNTROWS(dim_aluno) RETURN IF(v >= 1000000, FORMAT(DIVIDE(v, 1000000), \"0\") & \" Mi\", FORMAT(v, \"0\"))"
          },
          {
            "name": "Bases Integradas",
            "expression": "8",
            "formatString": "0"
          },
          {
            "name": "Total de Variáveis",
            "expression": "79",
            "formatString": "0"
          },
          {
            "name": "Cobertura Complementar",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(dim_aluno), dim_aluno[tem_complementar] = TRUE()), COUNTROWS(dim_aluno), 0)",
            "formatString": "0.00%"
          },
          {
            "name": "Estudantes com Matrículas",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(dim_aluno), dim_aluno[tem_matricula] = TRUE()), COUNTROWS(dim_aluno), 0)",
            "formatString": "0.00%"
          },
          {
            "name": "Estudantes com Avaliações",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(dim_aluno), dim_aluno[tem_nota] = TRUE()), COUNTROWS(dim_aluno), 0)",
            "formatString": "0.00%"
          },
          {
            "name": "Estudantes com Dados Financeiros",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(dim_aluno), dim_aluno[tem_financeiro] = TRUE()), COUNTROWS(dim_aluno), 0)",
            "formatString": "0.00%"
          },
          {
            "name": "Cobertura de Acessos",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(dim_aluno), dim_aluno[tem_acesso] = TRUE()), COUNTROWS(dim_aluno), 0)",
            "formatString": "0.00%"
          },
          {
            "name": "Cobertura de Redes Sociais",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(dim_aluno), dim_aluno[tem_redes] = TRUE()), COUNTROWS(dim_aluno), 0)",
            "formatString": "0.00%"
          },
          {
            "name": "Cobertura Digital Conjunta",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(dim_aluno), dim_aluno[cobertura_digital] = \"Acessos e redes\"), COUNTROWS(dim_aluno), 0)",
            "formatString": "0.00%"
          },
          {
            "name": "Sem Registros Digitais",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(dim_aluno), dim_aluno[cobertura_digital] = \"Nenhuma das duas\"), COUNTROWS(dim_aluno), 0)",
            "formatString": "0.00%"
          },
          {
            "name": "Média das Notas",
            "expression": "AVERAGE(dim_aluno[nota_media_clip])",
            "formatString": "0.00"
          }
        ]
      },
