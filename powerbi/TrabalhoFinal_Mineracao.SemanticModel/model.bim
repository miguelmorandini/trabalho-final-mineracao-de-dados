        "partitions": [
          {
            "name": "fato_matriculas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Csv.Document(File.Contents(\"c:\\\\Projects\\\\trabalho-final-mineacao-de-dados\\\\data\\\\gold\\\\fato_matriculas.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    #\"Cabeçalhos Promovidos\" = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    #\"Tipo Alterado\" = Table.TransformColumnTypes(#\"Cabeçalhos Promovidos\", {{\"id_matricula\", Int64.Type}, {\"id_aluno\", Int64.Type}, {\"faculdade\", type text}, {\"curso\", type text}, {\"semestre\", Int64.Type}, {\"status\", type text}, {\"id_curso\", Int64.Type}, {\"flag_evadido\", Int64.Type}, {\"flag_trancado\", Int64.Type}, {\"flag_ativo\", Int64.Type}})",
                "in",
                "    #\"Tipo Alterado\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Matriculas",
            "expression": "COUNTROWS(fato_matriculas)",
            "formatString": "#,0"
          },
          {
            "name": "Matriculas Ativas",
            "expression": "SUM(fato_matriculas[flag_ativo])",
            "formatString": "#,0"
          },
          {
            "name": "Matriculas Evadidas",
            "expression": "SUM(fato_matriculas[flag_evadido])",
            "formatString": "#,0"
          },
          {
            "name": "Matriculas Trancadas",
            "expression": "SUM(fato_matriculas[flag_trancado])",
            "formatString": "#,0"
          },
          {
            "name": "Taxa Evasao Matriculas (%)",
            "expression": "DIVIDE([Matriculas Evadidas], [Total Matriculas], 0)",
            "formatString": "0.00%"
          }
        ]
