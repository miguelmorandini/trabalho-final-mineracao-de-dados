              "expression": [
                "let",
                "    Fonte = #table(type table [faixa_acessos = text, ordem = Int64.Type], {{\"0\", 1}, {\"1\", 2}, {\"2–3\", 3}, {\"4–5\", 4}, {\"6–10\", 5}, {\"11+\", 6}})",
