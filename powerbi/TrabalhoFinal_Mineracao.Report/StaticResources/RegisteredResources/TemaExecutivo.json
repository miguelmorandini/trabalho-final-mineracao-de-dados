{
  "name": "TemaExecutivo",
  "dataColors": [
    "#1D6FA5",
    "#C62828",
    "#D97706",
    "#0F766E",
    "#64748B",
    "#3B82F6",
    "#475569",
    "#94A3B8"
  ],
  "background": "#F8FAFC",
  "foreground": "#0F2942",
  "tableAccent": "#1D6FA5",
  "good": "#1D6FA5",
  "neutral": "#64748B",
  "bad": "#C62828",
  "maximum": "#1D6FA5",
  "center": "#94A3B8",
  "minimum": "#C62828",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 24,
      "color": "#0F2942"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#0F2942"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#334155"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#475569"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0F2942"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#334155"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F1F5F9"
              }
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0F2942"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false,
            "radius": 6
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 30,
            "fontFamily": "Segoe UI Semibold",
            "color": {
              "solid": {
                "color": "#0F2942"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "data": [
          {
            "mode": "Dropdown"
          }
        ],
        "header": [
          {
            "show": false
          }
        ]
      }
    }
  }
}